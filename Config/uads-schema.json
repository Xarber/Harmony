{
  "type": "object",
  "required": [
    "uadsVersion",
    "manifestVersion",
    "project",
    "features",
    "distribution",
    "quality",
    "requirements",
    "exceptions"
  ],
  "properties": {
    "uadsVersion": {
      "const": "sections-01-52"
    },
    "manifestVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "repository",
        "profiles",
        "framework",
        "platforms",
        "hosting"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "hybrid",
              "mobile-app",
              "desktop-app",
              "web-app",
              "web-service",
              "backend-service",
              "cli-tool",
              "library"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "framework": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "ios",
              "ipados",
              "macos",
              "android",
              "web",
              "windows",
              "linux"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "hosting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "features": {
      "type": "object",
      "required": [
        "pwa",
        "landingPage",
        "onboarding",
        "developerOptions",
        "ideas",
        "screenshotRendering",
        "sampleData",
        "animations",
        "plugins",
        "peerToPeer"
      ],
      "properties": {
        "pwa": {
          "type": "string",
          "minLength": 1
        },
        "landingPage": {
          "type": "string",
          "minLength": 1
        },
        "onboarding": {
          "type": "string",
          "minLength": 1
        },
        "developerOptions": {
          "type": "string",
          "minLength": 1
        },
        "ideas": {
          "type": "string",
          "minLength": 1
        },
        "screenshotRendering": {
          "type": "string",
          "minLength": 1
        },
        "sampleData": {
          "type": "string",
          "minLength": 1
        },
        "animations": {
          "type": "string",
          "minLength": 1
        },
        "plugins": {
          "type": "string",
          "minLength": 1
        },
        "peerToPeer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distribution": {
      "type": "object",
      "required": [
        "web",
        "githubReleases",
        "altSource",
        "obtainium"
      ],
      "properties": {
        "web": {
          "type": "string",
          "format": "uri"
        },
        "githubReleases": {
          "type": "boolean"
        },
        "altSource": {
          "type": "boolean"
        },
        "obtainium": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "workflow",
        "budgets",
        "changedLineTarget",
        "changedBranchTarget"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "budgets": {
          "type": "string",
          "minLength": 1
        },
        "changedLineTarget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "changedBranchTarget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "applicability",
          "status",
          "rationale",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UADS-[A-Z]+-[0-9]{3}$"
          },
          "applicability": {
            "enum": [
              "required",
              "conditional",
              "optional",
              "not-applicable",
              "approved-exception"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked",
              "not-applicable",
              "waived"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "location",
                "commit",
                "verifiedOn",
                "method"
              ],
              "properties": {
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "verifiedOn": {
                  "type": "string",
                  "format": "date"
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "platforms",
          "reason",
          "risks",
          "mitigation",
          "approval",
          "approvedOn",
          "reviewOn",
          "reconsiderWhen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UADS-[A-Z]+-[0-9]{3}$"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "risks": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": "string",
            "minLength": 1
          },
          "approvedOn": {
            "type": "string",
            "format": "date"
          },
          "reviewOn": {
            "type": "string",
            "format": "date"
          },
          "reconsiderWhen": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
